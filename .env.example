# Local development API. Copy this file to .env and adjust if needed.
VITE_API_BASE_URL=http://localhost:4006
VITE_TENANT_ROOT_DOMAIN=restaurants.example.com
VITE_DEFAULT_TENANT_SLUG=sizzler-steak-house-and-co

# Production builds must supply an absolute, non-local HTTPS URL through the
# deployment environment, for example:
# VITE_API_BASE_URL=https://api.example.com
