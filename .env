# Published API used by the white-label restaurant website.
VITE_API_BASE_URL=http://localhost:4006

# Shopify-style tenant resolution. Localhost and preview deployments use the
# default tenant; production hostnames resolve from their subdomain.
VITE_TENANT_ROOT_DOMAIN=restaurants-domain.com
VITE_DEFAULT_TENANT_SLUG=sizzler-steak-house-and-co
